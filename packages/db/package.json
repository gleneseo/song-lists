{
  "name": "@song-lists/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./migrate": {
      "types": "./src/migrate.ts",
      "default": "./src/migrate.ts"
    },
    "./migrations": "./migrations"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "clean": "rimraf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/run-migrations.ts",
    "db:docs": "tsx src/generate-docs.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "effect": "^4.0.0-rc.112",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
