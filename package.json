{
  "name": "song-lists",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf dist .coverage .eslint",
    "build": "npm-run-all clean prettier:check lint build:tsc test:coverage proof",
    "build:tsc": "tsc",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "prettier:check": "prettier . --check --no-editorconfig --ignore-unknown",
    "prettier:write": "prettier . --write --no-editorconfig --ignore-unknown",
    "lint": "npm-run-all lint:eslint",
    "lint:eslint": "eslint .",
    "lint:eslint:report": "eslint . --output-file=.eslint/report.html --format=html",
    "proof": "git rev-parse HEAD | cowsay -r",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Gleneseo Engineering",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": "^11.13.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "cowsay": "^1.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*": "prettier --write --no-editorconfig --ignore-unknown"
  },
  "dependencies": {
    "@effect/platform": "^0.97.0",
    "@effect/platform-node": "^0.108.0",
    "effect": "^3.22.0"
  }
}
