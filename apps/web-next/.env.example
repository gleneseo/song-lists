# Read by lib/queries/client.ts. Same meaning as the root .env's DATABASE_URL --
# point it at the same Postgres instance (e.g. the docker-compose one) so this
# app sees the same song catalog.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/default

# Read by Better Auth itself, which lib/auth/auth.ts sets up. Next only loads
# .env files from this app's own directory, so it is set here rather than
# relying on the root .env. Generate a value with `openssl rand -base64 32`;
# do not reuse the same secret across environments. For local dev you can
# copy the root .env's BETTER_AUTH_SECRET instead, so there is only one.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-output

# Read by lib/auth/auth.ts. Auth callbacks and redirects are validated against
# this origin.
BETTER_AUTH_URL=http://localhost:3000

# Read by lib/auth/auth-client.ts. Must match BETTER_AUTH_URL above -- the
# NEXT_PUBLIC_ prefix is what makes it available to client components.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Optional. What the app calls itself in the header and the browser tab;
# "Song Lists" when this is unset or blank. Like the variable above it is
# fixed when the app is built, so changing it means building again.
# NEXT_PUBLIC_APP_TITLE=Song Lists

# Optional. Songs are looked up on iTunes for their art and album when they are
# added; set this to "off" to skip that (the browser tests do).
# SONG_METADATA_LOOKUP=off
