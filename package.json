{
  "name": "song-lists",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "clean": "npm run clean --workspaces --if-present && rimraf .coverage .eslint",
    "build": "npm-run-all clean prettier:check lint build:tsc typecheck:web-next typecheck:uat test:coverage proof",
    "build:tsc": "tsc -b",
    "typecheck:web-next": "npm run typecheck -w @song-lists/web-next",
    "start": "npm run start -w @song-lists/cli",
    "db:generate": "npm run db:generate -w @song-lists/db",
    "db:migrate": "npm run db:migrate -w @song-lists/db",
    "db:reset": "npm run db:reset -w @song-lists/db",
    "db:docs": "npm run db:docs -w @song-lists/db",
    "db:studio": "npm run db:studio -w @song-lists/db",
    "check:seed-art": "npm run check-seed-art -w @song-lists/song-metadata",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:unit": "vitest --run --project 'unit-*'",
    "test:integration": "vitest --run --project integration",
    "prettier:check": "prettier . --check --no-editorconfig --ignore-unknown",
    "prettier:write": "prettier . --write --no-editorconfig --ignore-unknown",
    "lint": "npm-run-all lint:eslint lint:eslint:web-next",
    "lint:eslint": "eslint .",
    "lint:eslint:web-next": "npm run lint -w @song-lists/web-next",
    "lint:eslint:report": "eslint . --output-file=.eslint/report.html --format=html",
    "proof": "git rev-parse HEAD | cowsay -r",
    "prepare": "husky && effect-language-service patch",
    "typecheck:uat": "tsc -p tests/uat/tsconfig.json",
    "test:uat": "playwright test -c tests/uat/playwright.config.ts",
    "test:uat:headed": "playwright test -c tests/uat/playwright.config.ts --headed",
    "test:uat:report": "playwright show-report .uat-report"
  },
  "keywords": [],
  "author": "Gleneseo Engineering",
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": "^12.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@effect/language-service": "^0.87.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "cowsay": "^1.6.0",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.9.10",
    "rimraf": "^6.1.4",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*": "prettier --write --no-editorconfig --ignore-unknown"
  }
}
