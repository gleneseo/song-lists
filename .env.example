# Used by docker-compose.yml to configure the local Postgres container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=default
POSTGRES_PORT=5432

# Used by src/db/client.ts and drizzle.config.ts. Should match the
# POSTGRES_* values above when pointed at the local docker-compose database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/default
