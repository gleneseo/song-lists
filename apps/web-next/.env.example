# Read by lib/db.ts. Same meaning as the root .env's DATABASE_URL -- point
# it at the same Postgres instance (e.g. the docker-compose one) so this app
# sees the same song catalog.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/default

# Read by lib/auth/auth.ts. Next only loads .env files from this app's own
# directory, so this is set here too rather than relying on the root .env.
# Generate a value with `openssl rand -base64 32`; do not reuse the same
# secret across environments.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-output

# Auth callbacks and redirects are validated against this origin.
BETTER_AUTH_URL=http://localhost:3000

# Read by lib/auth/auth-client.ts. Must match BETTER_AUTH_URL above -- the
# NEXT_PUBLIC_ prefix is what makes it available to client components.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
