# Used by docker-compose.yml to configure the local Postgres container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=default
POSTGRES_PORT=5432

# Used by src/db/client.ts and drizzle.config.ts. Should match the
# POSTGRES_* values above when pointed at the local docker-compose database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/default

# Only when using a Neon database (added by `neon init`). The direct (not
# pooled) connection string, for running migrations; DATABASE_URL then holds
# the pooled one. Neither value below is real.
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# NEON_BRANCH=main

# Read automatically by Better Auth (src/auth/auth.ts). Generate a real value
# with `openssl rand -base64 32` -- do not reuse this one outside local dev.
BETTER_AUTH_SECRET=7WWhlpjinaNSjgytSKaR+l/KpZyTeLlG98c/dr8TPA0=

# The origin auth callbacks and redirects are validated against.
BETTER_AUTH_URL=http://localhost:3000

# Only for `npm run db:harden`, which gives every seeded account the password
# "<username><this value>" on a deployed database. Needs at least 7 random
# characters; keep the real value out of the repository.
# HARDEN_PASSWORD_SUFFIX=doughnuts
