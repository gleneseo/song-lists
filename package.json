{
  "name": "song-lists",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf dist .coverage .eslint",
    "build": "npm-run-all clean prettier:check lint build:tsc test:coverage docker:build proof",
    "build:tsc": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:docs": "drizzle-docs generate ./src/db/schema/song-lists.ts -d postgresql -o ./docs/db/schema.md --single-file --force && printf '%s\\n\\n%s\\n' 'Note: column names shown below are Drizzle property names, not real database column names, since this project only applies snake_case casing at query and migration time. See ./migrations for real column names.' \"$(cat docs/db/schema.md)\" > docs/db/schema.md",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:unit": "vitest --run --projet unit",
    "test:integration": "vitest --run --project integration",
    "test:integration:delete-me": "vitest --run --config vitest.integration.config.ts",
    "prettier:check": "prettier . --check --no-editorconfig --ignore-unknown",
    "prettier:write": "prettier . --write --no-editorconfig --ignore-unknown",
    "lint": "npm-run-all lint:eslint",
    "lint:eslint": "eslint .",
    "lint:eslint:report": "eslint . --output-file=.eslint/report.html --format=html",
    "docker:build": " docker build . --tag gleneseo-ts-template:latest",
    "docker:run": " docker run --rm -it -t gleneseo-ts-template:latest",
    "proof": "git rev-parse HEAD | cowsay -r",
    "prepare": "husky && effect-language-service patch"
  },
  "keywords": [],
  "author": "Gleneseo Engineering",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": "^12.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@effect/language-service": "^0.87.2",
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "@vitest/coverage-v8": "^4.1.10",
    "cowsay": "^1.6.0",
    "drizzle-docs-generator": "^0.7.2",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*": "prettier --write --no-editorconfig --ignore-unknown"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.0-beta.107",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "effect": "^4.0.0-beta.107",
    "pg": "^8.22.0",
    "testcontainers": "^12.1.0"
  }
}
