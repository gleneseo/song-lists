{
  "extends": [
    "@tsconfig/node24/tsconfig.json",
    "@tsconfig/strictest/tsconfig.json"
  ],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "plugins": [{ "name": "@effect/language-service" }],
    "incremental": true,
    "composite": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src", "tests"]
}
